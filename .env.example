# URL proyek Supabase, misalnya https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Gunakan anon key yang aman untuk client dengan RLS.
# Jangan pernah menaruh service_role/secret key di frontend.
VITE_SUPABASE_ANON_KEY=

# Branding Toko / Aplikasi (Opsional)
# Default jika kosong adalah "SmartStock"
VITE_APP_NAME=
VITE_APP_TAGLINE=
